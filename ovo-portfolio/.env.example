# --- Database ---
# Neon PostgreSQL connection string. Use the pooled URL ("?sslmode=require") from Neon dashboard.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# --- NextAuth (Auth.js) ---
# Generate with: npx auth secret  (writes a strong random string)
AUTH_SECRET="replace-with-output-of-npx-auth-secret"

# In dev keep true. In production behind a known proxy (e.g., Vercel) leave true.
AUTH_TRUST_HOST=true

# GitHub OAuth app — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github  (dev)
GITHUB_ID=""
GITHUB_SECRET=""

# Comma-separated list of email addresses allowed to sign in to /admin.
# Anything not in this list is rejected by the signIn callback.
ADMIN_EMAILS="you@example.com"
